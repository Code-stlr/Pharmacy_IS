# Local development only. Generate unique values; never commit .env.
DJANGO_SECRET_KEY=your_long_django_password
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=pharmacy
POSTGRES_USER=pharmacy
POSTGRES_PASSWORD=replace-with-a-local-password
# Optional: managed Neon database. PG* values take precedence over POSTGRES_*.
# PGHOST=ep-your-endpoint.eu-central-1.aws.neon.tech
# PGDATABASE=neondb
# PGUSER=neondb_owner
# PGPASSWORD=replace-with-your-neon-password
# PGSSLMODE=require
# PGCHANNELBINDING=require
# COMPOSE_FILE=docker-compose.yml;docker-compose.external-db.yml
# Windows uses ; between Compose files; Linux/macOS use :.
# Enable managed Neon Better Auth (the Auth URL, not the PostgreSQL host).
# NEON_AUTH_URL=https://your-endpoint.neonauth.region.aws.neon.tech/neondb/auth
# Optional overrides; defaults are the Auth URL origin.
# NEON_AUTH_ISSUER=https://your-endpoint.neonauth.region.aws.neon.tech
# NEON_AUTH_AUDIENCE=https://your-endpoint.neonauth.region.aws.neon.tech
SERPAPI_API_KEY=replace-with-an-api-key
TAVILY_API_KEY=replace-with-an-api-key
EXA_API_KEY=replace-with-an-api-key
